{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {},
      "env": {
        "EXPO_UPDATES_TARGET": "build"
      },
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_UPDATES_TARGET": "build"
      },
      "environment": "preview"
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_UPDATES_TARGET": "build"
      },
      "environment": "production",
      "autoIncrement": true
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
