{
  "expo": {
    "name": "Zob Connect",
    "slug": "zip-hrms-mobile",
    "scheme": "ziphrmsmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sdcomputronix.ziphrmsmobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Zob Connect uses your camera to take a live photo when you clock in or out, to set up face verification, and to take your profile picture.",
        "NSPhotoLibraryUsageDescription": "Zob Connect lets you choose an existing photo as your profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sdcomputronix.ziphrmsmobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#020818",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationWhenInUsePermission": "Zob Connect checks your location when you clock in or out, to confirm you are at your assigned store.",
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zob Connect lets you choose an existing photo as your profile picture.",
          "cameraPermission": "Zob Connect uses your camera to take a live photo when you clock in or out, to set up face verification, and to take your profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Zob Connect uses your camera to take a live photo when you clock in or out, to set up face verification, and to take your profile picture.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E40AF",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-status-bar",
      "expo-font",
      "./plugins/withMonitoringTool"
    ],
    "owner": "contactkiwis-team",
    "extra": {
      "eas": {
        "projectId": "1b235d14-6d40-40d8-a047-4a43cc965ccd"
      }
    }
  }
}
